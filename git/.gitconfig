[user]
	email = kris.braun@gmail.com
	name = Kris Braun
[core]
	excludesfile = ~/.gitignore_global
[push]
	default = current
[pull]
	rebase = true
	ff = false
[fetch]
	prune = true
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
